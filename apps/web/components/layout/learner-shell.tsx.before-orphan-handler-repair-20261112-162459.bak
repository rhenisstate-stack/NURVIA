import * as React from "react";
import Link from "next/link";
import { usePathname, useRouter } from "next/navigation";
import { Logo } from "@/components/brand/logo";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import {
  LayoutDashboard,
  TrendingUp,
  CalendarCheck,
  Library,
  BookMarked,
  FileSpreadsheet,
  History,
  Layers,
  FileText,
  CreditCard,
  HeartHandshake,
  Calculator,
  BotMessageSquare,
  Bookmark,
  Users,
  User,
  Settings,
  ChevronLeft,
  ChevronRight,
  ChevronDown,
  Menu,
  X,
  Search,
  Bell,
  Flame,
  Award,
  ExternalLink,
  GraduationCap,
  Stethoscope,
  Sparkles,
  ShieldAlert,
} from "lucide-react";
import { cn } from "@/lib/utils";
import { useAuth } from "@/components/auth/auth-provider";
import { UserAccountMenu } from "@/components/layout/user-account-menu";
import { nurviaApi } from "@/lib/api-client";
interface NavSubItem {
  name: string;
  href: string;
}

interface NavItem {
  name: string;
  href: string;
  icon: React.ElementType;
  badge?: string;
  subItems?: NavSubItem[];
}

interface NavSection {
  title: string;
  items: NavItem[];
}

export const learnerNavigation: NavSection[] = [
  {
    title: "OVERVIEW",
    items: [
      { name: "Dashboard", href: "/learner", icon: LayoutDashboard },
      { name: "Performance", href: "/learner/performance", icon: TrendingUp },
      { name: "Study Planner", href: "/learner/planner", icon: CalendarCheck, badge: "New" },
    ],
  },
  {
    title: "EXAMS",
    items: [
      {
        name: "RN Exams",
        href: "/learner/exams?track=RN",
        icon: GraduationCap,
        subItems: [
          { name: "ATI Assessments", href: "/learner/exams?track=RN&category=ATI" },
          { name: "HESI Specialty", href: "/learner/exams?track=RN&category=HESI" },
          { name: "Regular Courses", href: "/learner/exams?track=RN&category=RegularCourse" },
          { name: "Certifications", href: "/learner/exams?track=RN&category=Certification" },
        ],
      },
      {
        name: "LPN / PN Exams",
        href: "/learner/exams?track=PN_LPN",
        icon: Stethoscope,
        subItems: [
          { name: "ATI Practical", href: "/learner/exams?track=PN_LPN&category=ATI" },
          { name: "HESI PN", href: "/learner/exams?track=PN_LPN&category=HESI" },
          { name: "Regular Courses", href: "/learner/exams?track=PN_LPN&category=RegularCourse" },
          { name: "Certifications", href: "/learner/exams?track=PN_LPN&category=Certification" },
        ],
      },
      {
        name: "RN Exit",
        href: "/learner/exams?track=RN_Exit",
        icon: Award,
        badge: "Predictor",
        subItems: [
          { name: "Comprehensive Predictor", href: "/learner/exams?track=RN_Exit&category=ExitPredictor" },
          { name: "HESI Exit Assessment", href: "/learner/exams?track=RN_Exit&category=HESI" },
        ],
      },
      {
        name: "LPN Exit",
        href: "/learner/exams?track=PN_Exit",
        icon: Award,
        badge: "Predictor",
        subItems: [
          { name: "PN Exit Predictor", href: "/learner/exams?track=PN_Exit&category=ExitPredictor" },
        ],
      },
    ],
  },
  {
    title: "PRACTICE",
    items: [
      { name: "Study Library", href: "/learner/library", icon: Library },
      { name: "My Library", href: "/learner/my-exams", icon: BookMarked },
      { name: "Custom Practice", href: "/learner/custom-practice", icon: FileSpreadsheet },
      { name: "Attempt History", href: "/learner/history", icon: History },
    ],
  },
  {
    title: "RESOURCES",
    items: [
      { name: "Study Hub", href: "/learner/hub", icon: Layers },
      { name: "Study Guides", href: "/learner/guides", icon: FileText },
      { name: "Flashcards", href: "/learner/flashcards", icon: Layers, badge: "SRS" },
      { name: "Care Plans", href: "/learner/care-plans", icon: HeartHandshake },
      { name: "Calculators", href: "/learner/calculators", icon: Calculator },
    ],
  },
  {
    title: "PERSONALIZED LEARNING",
    items: [
      { name: "AI Tutor", href: "/learner/ai-tutor", icon: BotMessageSquare, badge: "AI" },
      { name: "Saved Questions", href: "/learner/saved-questions", icon: Bookmark },
      { name: "Community", href: "/learner/community", icon: Users },
    ],
  },
  {
    title: "ACCOUNT",
    items: [
      { name: "My Account", href: "/learner/account", icon: User },
      { name: "Settings", href: "/learner/settings", icon: Settings },
      { name: "Subscription", href: "/learner/subscription", icon: CreditCard },
    ],
  },
];

export function LearnerShell({ children }: { children: React.ReactNode }) {
  const [collapsed, setCollapsed] = React.useState(false);
  const [mobileOpen, setMobileOpen] = React.useState(false);
  const [expandedSections, setExpandedSections] = React.useState<Record<string, boolean>>({
    "RN Exams": true,
    "LPN / PN Exams": false,
    "RN Exit": false,
    "LPN Exit": false,
  });
  const [topSearch, setTopSearch] = React.useState("");
  const [avatarUrl, setAvatarUrl] = React.useState<string | null>(null);
  const router = useRouter();
  const pathname = usePathname();
  const { status, user, error } = useAuth();

  React.useEffect(() => {
    if (status === "unauthenticated") {
      const returnTo = typeof window === "undefined"
        ? pathname
        : `${pathname}${window.location.search}`;
      router.replace(`/sign-in?returnTo=${encodeURIComponent(returnTo)}`);
    } else if (status === "authenticated" && user && user.role !== "Learner" && user.role !== "Superadmin") {
      router.replace("/access-denied");
    }
  }, [status, user, pathname, router]);
React.useEffect(() => {
    if (status !== "authenticated" || !user) {
      setAvatarUrl(null);
      return;
    }

    let active = true;

    const loadAvatar = async () => {
      try {
        const response = await nurviaApi.getAvatar();

        if (active) {
          setAvatarUrl(
            response.success && response.data?.storageKey
              ? `/api/avatar/${response.data.storageKey}`
              : null
          );
        }
      } catch {
        if (active) setAvatarUrl(null);
      }
    };

    const handleAvatarUpdated = () => {
      void loadAvatar();
    };

    void loadAvatar();
    window.addEventListener("nurvia:avatar-updated", handleAvatarUpdated);

    return () => {
      active = false;
      window.removeEventListener("nurvia:avatar-updated", handleAvatarUpdated);
    };
  }, [status, user?.id]);

  const toggleSubmenu = (itemName: string, e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    setExpandedSections((prev) => ({
      ...prev,
      [itemName]: !prev[itemName],
    }));
  };

  const handleGlobalSearch = (e: React.FormEvent) => {
    e.preventDefault();
    if (topSearch.trim()) {
      router.push(`/learner/library?q=${encodeURIComponent(topSearch.trim())}`);
    }
  };
    router.replace("/");
  }

  // Superadmin is explicitly admitted to the learner experience with the same
  // authenticated identity; other staff roles are redirected to access-denied.
  if (status === "loading" || status === "unauthenticated" ||
      (status === "authenticated" &&
        user?.role !== "Learner" && user?.role !== "Superadmin")) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-background px-6 text-sm text-foreground-secondary" aria-live="polite">
        {status === "loading" ? "Checking your sessionâ€¦" : "Redirecting to the appropriate pageâ€¦"}
      </main>
    );
  }

  if (status === "error") {
    return (
      <main className="flex min-h-screen items-center justify-center bg-background px-6">
        <p role="alert" className="max-w-md text-center text-sm text-rose-700 dark:text-rose-300">
          {error || "Unable to verify your sign-in. Refresh the page or try again."}
        </p>
      </main>
    );
  }

  return (
    <div className="min-h-screen bg-background text-foreground flex">
      {/* Mobile Drawer Backdrop */}
      {mobileOpen && (
        <div
          className="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm lg:hidden"
          onClick={() => setMobileOpen(false)}
        />
      )}

      {/* Sidebar Container */}
      <aside
        className={cn(
          "fixed inset-y-0 left-0 z-50 flex flex-col border-r border-border bg-surface transition-all duration-300 ease-in-out",
          collapsed ? "w-[76px]" : "w-[264px]",
          mobileOpen ? "translate-x-0" : "-translate-x-full lg:translate-x-0"
        )}
      >
        {/* Brand Header */}
        <div className="flex h-16 items-center justify-between px-4 border-b border-border">
          <Link href="/learner" className="flex items-center gap-2 overflow-hidden">
            <Logo size={collapsed ? "sm" : "md"} variant={collapsed ? "symbol" : "full"} withLink={false} />
          </Link>
          <div className="flex items-center gap-1">
            <Button
              variant="ghost"
              size="icon"
              className="hidden lg:flex text-foreground-muted hover:text-foreground h-8 w-8"
              onClick={() => setCollapsed(!collapsed)}
              aria-label={collapsed ? "Expand sidebar" : "Collapse sidebar"}
            >
              {collapsed ? <ChevronRight className="h-4 w-4" /> : <ChevronLeft className="h-4 w-4" />}
            </Button>
            <Button
              variant="ghost"
              size="icon"
              className="lg:hidden text-foreground-muted hover:text-foreground h-8 w-8"
              onClick={() => setMobileOpen(false)}
              aria-label="Close sidebar"
            >
              <X className="h-5 w-5" />
            </Button>
          </div>
        </div>

        {/* Navigation Sections */}
        <div className="flex-1 overflow-y-auto px-3 py-4 space-y-5">
          {learnerNavigation.map((section) => (
            <div key={section.title} className="space-y-1">
              {!collapsed ? (
                <div className="px-3 text-[10px] font-bold uppercase tracking-wider text-foreground-muted/80 mb-1.5">
                  {section.title}
                </div>
              ) : (
                <div className="h-px bg-border my-2" />
              )}

              {section.items.map((item) => {
                const Icon = item.icon;
                const isActive =
                  pathname === item.href ||
                  (item.subItems && item.subItems.some((s) => pathname === s.href));
                const isSubmenuOpen = expandedSections[item.name];

                return (
                  <div key={item.name} className="space-y-1">
                    <div className="flex items-center">
                      <Link
                        href={item.href}
                        onClick={() => setMobileOpen(false)}
                        className={cn(
                          "group flex flex-1 items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors",
                          isActive
                            ? "bg-brand-navy text-white shadow-xs font-semibold dark:bg-brand-teal/20 dark:text-brand-teal"
                            : "text-foreground-secondary hover:bg-surface-muted hover:text-foreground",
                          collapsed && "justify-center px-2"
                        )}
                        title={collapsed ? item.name : undefined}
                      >
                        <Icon
                          className={cn(
                            "h-4 w-4 shrink-0 transition-transform group-hover:scale-110",
                            isActive ? "text-brand-teal" : "text-foreground-muted"
                          )}
                        />
                        {!collapsed && <span className="flex-1 truncate">{item.name}</span>}
                        {!collapsed && item.badge && (
                          <span
                            className={cn(
                              "rounded-full px-1.5 py-0.2 text-[9px] font-bold uppercase",
                              isActive
                                ? "bg-white/20 text-white"
                                : "bg-brand-teal/15 text-brand-teal dark:text-teal-300"
                            )}
                          >
                            {item.badge}
                          </span>
                        )}
                      </Link>

                      {/* Expand Submenu Chevron if subitems exist */}
                      {!collapsed && item.subItems && (
                        <button
                          type="button"
                          onClick={(e) => toggleSubmenu(item.name, e)}
                          className="p-1 rounded-md hover:bg-surface-muted text-foreground-muted hover:text-foreground transition-colors"
                          aria-label={`Toggle ${item.name} subcategories`}
                        >
                          <ChevronDown
                            className={cn(
                              "h-3 w-3 transition-transform duration-200",
                              isSubmenuOpen && "rotate-180"
                            )}
                          />
                        </button>
                      )}
                    </div>

                    {/* Expandable Sub-items */}
                    {!collapsed && item.subItems && isSubmenuOpen && (
                      <div className="pl-6 pr-1 space-y-0.5 border-l-2 border-brand-teal/20 ml-3 py-1">
                        {item.subItems.map((sub) => {
                          const isSubActive = pathname === sub.href;
                          return (
                            <Link
                              key={sub.name}
                              href={sub.href}
                              onClick={() => setMobileOpen(false)}
                              className={cn(
                                "block px-2 py-1 rounded-md text-[11px] font-medium transition-colors",
                                isSubActive
                                  ? "text-brand-teal font-semibold bg-brand-teal/10"
                                  : "text-foreground-muted hover:text-foreground hover:bg-surface-muted"
                              )}
                            >
                              {sub.name}
                            </Link>
                          );
                        })}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          ))}
        </div>

        {/* Sidebar Footer */}
        <div className="p-3 border-t border-border bg-surface-muted/40">
          {!collapsed ? (
            <div className="rounded-xl border border-border bg-surface p-3 space-y-2">
              <p className="truncate text-xs font-semibold text-foreground">{user?.name}</p>
              <Link href="/learner/exams">
                <Button size="sm" className="w-full text-xs h-8">Browse Practice Exams</Button>
              </Link>
            </div>
          ) : (
            <div className="flex justify-center py-2">
              <Award className="w-5 h-5 text-brand-teal" />
            </div>
          )}
        </div>
      </aside>

      {/* Main Content Area */}
      <div
        className={cn(
          "flex-1 flex flex-col min-w-0 transition-all duration-300 ease-in-out",
          collapsed ? "lg:ml-[76px]" : "lg:ml-[264px]"
        )}
      >
        {/* Top Learner Navbar matching screenshot */}
        <header className="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-border bg-surface/90 backdrop-blur-md px-4 sm:px-6">
          <div className="flex items-center gap-3">
            <Button
              variant="ghost"
              size="icon"
              className="lg:hidden"
              onClick={() => setMobileOpen(true)}
              aria-label="Open navigation sidebar"
            >
              <Menu className="h-5 w-5" />
            </Button>

            {/* Global Search Bar */}
            <form onSubmit={handleGlobalSearch} className="relative hidden sm:block w-72 md:w-96">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-foreground-muted" />
              <input
                type="search"
                value={topSearch}
                onChange={(e) => setTopSearch(e.target.value)}
                placeholder="Search study sets, topics, or keywords..."
                className="w-full rounded-full border border-border bg-background pl-9 pr-4 py-1.5 text-xs sm:text-sm placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-brand-teal"
              />
            </form>
          </div>

          <div className="flex items-center gap-3">
  <ThemeToggle />
  <UserAccountMenu avatarUrl={avatarUrl} />
</div>
        </header>

        {/* Page Content Body */}
        <main className="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
          {children}
        </main>
      </div>
    </div>
  );
}


