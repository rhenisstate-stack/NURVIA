using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;
using Nurvia.Domain.Lectures;

namespace Nurvia.Infrastructure.Persistence.Configurations;

public class LectureConfiguration : IEntityTypeConfiguration<Lecture>
{
    public void Configure(EntityTypeBuilder<Lecture> builder)
    {
        builder.ToTable("Lectures");

        builder.HasKey(lecture => lecture.Id);

        builder.Property(lecture => lecture.Number)
            .IsRequired();

        builder.HasIndex(lecture => lecture.Number)
            .IsUnique();

        builder.Property(lecture => lecture.Slug)
            .IsRequired()
            .HasMaxLength(160);

        builder.HasIndex(lecture => lecture.Slug)
            .IsUnique();

        builder.Property(lecture => lecture.Title)
            .IsRequired()
            .HasMaxLength(250);

        builder.Property(lecture => lecture.Category)
            .IsRequired()
            .HasMaxLength(100);

        builder.Property(lecture => lecture.Summary)
            .IsRequired()
            .HasMaxLength(2000);

        builder.Property(lecture => lecture.BodyMarkdown)
            .IsRequired();

        builder.Property(lecture => lecture.HighYieldConcepts)
            .HasColumnType("text[]")
            .IsRequired();

        builder.Property(lecture => lecture.Status)
            .HasConversion<string>()
            .HasMaxLength(30)
            .IsRequired();

        builder.Property(lecture => lecture.AccessLevel)
            .HasConversion<string>()
            .HasMaxLength(40)
            .IsRequired();

        builder.Property(lecture => lecture.CreatedBy)
            .IsRequired()
            .HasMaxLength(100);

        builder.Property(lecture => lecture.UpdatedBy)
            .HasMaxLength(100);

        builder.HasIndex(lecture => new
        {
            lecture.Status,
            lecture.AccessLevel
        });
    }
}